
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
APP_REFERRER_URL=https://your-app-url.example
APP_TITLE=fastapi-streaming-chat

REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# Sliding window: number of most-recent messages kept per session.
MAX_CONTEXT_MESSAGES=10
# How long a cached LLM response stays valid.
CACHE_TTL_SECONDS=3600
# How long an idle session's history is kept before Redis expires it.
SESSION_TTL_SECONDS=86400
